{
  "info": {
    "name": "Diffusion API — Fiche d'analyse (module Avis)",
    "description": "The full analysis cycle: a delivery arrives, the chef de projet assigns an instruction, the expert produces the fiche, submits it, and the chef de projet accepts or rejects it — a rejection opening version 2 automatically.\n\nONE MANUAL STEP: in \"0. Setup → Upload the plans\", attach 2 files yourself (Postman cannot carry files inside a collection). Run that request twice, choosing a different file each time.\n\nTwo accounts are used:\n- the admin, who plays the chef de projet (holds ANALYSIS_DECIDE)\n- the expert, who must be an EXECUTANT of the instruction and hold ANALYSIS_CREATE/UPDATE (default: chef@creaconsult.com)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "admin@creaconsult.com" },
    { "key": "adminPassword", "value": "Admin@2026!" },
    { "key": "expertEmail", "value": "chef@creaconsult.com" },
    { "key": "expertPassword", "value": "Str0ngP@ssword" },
    { "key": "adminToken", "value": "" },
    { "key": "expertToken", "value": "" },
    { "key": "adminUserId", "value": "" },
    { "key": "expertUserId", "value": "" },
    { "key": "siteId", "value": "" },
    { "key": "dossierTypeId", "value": "" },
    { "key": "dossierId", "value": "" },
    { "key": "courrierId", "value": "" },
    { "key": "instructionId", "value": "" },
    { "key": "sheetV1Id", "value": "" },
    { "key": "sheetV2Id", "value": "" },
    { "key": "item1Id", "value": "" },
    { "key": "item2Id", "value": "" },
    { "key": "v2ItemId", "value": "" },
    { "key": "stamp", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Login — chef de projet (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('stamp', String(Date.now()).slice(-6));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
          }
        },
        {
          "name": "Login — expert",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('expertToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{expertEmail}}\",\n  \"password\": \"{{expertPassword}}\"\n}" },
            "description": "This account needs ANALYSIS_READ / CREATE / UPDATE on one of its roles."
          }
        },
        {
          "name": "Capture both user ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminUserId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Capture the expert's id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const me = pm.response.json();",
                  "pm.collectionVariables.set('expertUserId', me.id);",
                  "pm.test('the expert can work on analyses', () => {",
                  "  pm.expect(me.permissions).to.include('ANALYSIS_CREATE');",
                  "  pm.expect(me.permissions).to.include('ANALYSIS_UPDATE');",
                  "});",
                  "pm.test('the expert is attached to at least one site', () => pm.expect(me.sites.length).to.be.above(0));",
                  "pm.collectionVariables.set('siteId', me.sites[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{expertToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "The dossier is created on the expert's own site, so the analysis stays inside their perimeter."
          }
        },
        {
          "name": "Create the dossier type",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('dossierTypeId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/dossier-types", "host": ["{{baseUrl}}"], "path": ["dossier-types"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Dossier d'execution {{stamp}}\"\n}" }
          }
        },
        {
          "name": "Create the dossier",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('dossierId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/dossiers", "host": ["{{baseUrl}}"], "path": ["dossiers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dossier d'execution {{stamp}} - Port Autonome\",\n  \"siteId\": \"{{siteId}}\",\n  \"typeId\": \"{{dossierTypeId}}\",\n  \"responsibleId\": \"{{expertUserId}}\"\n}"
            }
          }
        },
        {
          "name": "Register the delivery (courrier entrant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('courrierId', body.id);",
                  "pm.test('status RECU', () => pm.expect(body.status).to.eql('RECU'));",
                  "console.log('courrierId = ' + body.id + ' — paste it in the upload request below.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/courriers", "host": ["{{baseUrl}}"], "path": ["courriers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dossierId\": \"{{dossierId}}\",\n  \"direction\": \"ENTRANT\",\n  \"subject\": \"Remise n1 - dossier d'execution {{stamp}}\"\n}"
            }
          }
        },
        {
          "name": "⚠️ Upload the plans (attach files yourself, run twice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('attached to the delivery', () => pm.expect(pm.response.json().courrierId).to.eql(pm.collectionVariables.get('courrierId')));",
                  "console.log('Run this request once per plan — each document becomes one element of the fiche.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/documents", "host": ["{{baseUrl}}"], "path": ["documents"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Pick a PDF — a different one on each run" },
                { "key": "courrierId", "value": "{{courrierId}}", "type": "text" }
              ]
            },
            "description": "MANUAL STEP: choose the file in the Body tab. Leave dossierId and livrableId out entirely. RustFS must be running."
          }
        },
        {
          "name": "Check the delivery's documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const docs = pm.response.json();",
                  "pm.test('at least 2 plans were uploaded', () => pm.expect(docs.length).to.be.at.least(2));",
                  "pm.test('storage keys are not exposed in listings', () => pm.expect(docs[0]).to.not.have.property('storageKey'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/documents?courrierId={{courrierId}}",
              "host": ["{{baseUrl}}"],
              "path": ["documents"],
              "query": [{ "key": "courrierId", "value": "{{courrierId}}" }]
            }
          }
        },
        {
          "name": "Assign the analysis (instruction)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('instructionId', body.id);",
                  "pm.test('assigned, so EN_COURS', () => pm.expect(body.status).to.eql('EN_COURS'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/instructions", "host": ["{{baseUrl}}"], "path": ["instructions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dossierId\": \"{{dossierId}}\",\n  \"courrierId\": \"{{courrierId}}\",\n  \"title\": \"Analyser le dossier d'execution recu {{stamp}}\",\n  \"executantIds\": [\"{{expertUserId}}\"],\n  \"dueDate\": \"2026-12-31\"\n}"
            },
            "description": "The expert must be an EXECUTANT here — only an executant can produce the fiche."
          }
        }
      ]
    },
    {
      "name": "1. The expert produces the fiche",
      "item": [
        {
          "name": "GUARD — the chef de projet cannot write it → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.include('executant of this instruction'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/analysis-sheets", "host": ["{{baseUrl}}"], "path": ["analysis-sheets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courrierId\": \"{{courrierId}}\",\n  \"instructionId\": \"{{instructionId}}\"\n}"
            },
            "description": "The fiche belongs to the person who was asked to do the work."
          }
        },
        {
          "name": "Create the fiche (elements auto-created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('sheetV1Id', body.id);",
                  "pm.collectionVariables.set('item1Id', body.items[0].id);",
                  "pm.collectionVariables.set('item2Id', body.items[1] ? body.items[1].id : body.items[0].id);",
                  "pm.test('reference generated (FA-xxxxxx)', () => pm.expect(body.reference).to.match(/^FA-/));",
                  "pm.test('a livrable v1 carries it', () => {",
                  "  pm.expect(body.livrable.version).to.eql(1);",
                  "  pm.expect(body.livrable.status).to.eql('EN_PREPARATION');",
                  "});",
                  "pm.test('one element per uploaded plan', () => pm.expect(body.items.length).to.be.at.least(2));",
                  "pm.test('each element got the 6 default criteria at NA', () => {",
                  "  pm.expect(body.items[0].criteria.length).to.eql(6);",
                  "  pm.expect(body.items[0].criteria.every((c) => c.opinion === 'NA')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{expertToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/analysis-sheets", "host": ["{{baseUrl}}"], "path": ["analysis-sheets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courrierId\": \"{{courrierId}}\",\n  \"instructionId\": \"{{instructionId}}\",\n  \"refBL\": \"BL-{{stamp}}\",\n  \"lieuUsage\": \"Chantier Port Autonome\",\n  \"norme\": \"NF EN 1992-1-1\",\n  \"docsReferences\": [\"Dossier d'execution\", \"Plans d'execution\"]\n}"
            }
          }
        },
        {
          "name": "GUARD — a second live fiche on the delivery → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.include('one live fiche per delivery'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{expertToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/analysis-sheets", "host": ["{{baseUrl}}"], "path": ["analysis-sheets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courrierId\": \"{{courrierId}}\",\n  \"instructionId\": \"{{instructionId}}\"\n}"
            }
          }
        },
        {
          "name": "Element 1 — grid all favourable",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const sheet = pm.response.json();",
                  "const item = sheet.items.find((i) => i.id === pm.collectionVariables.get('item1Id'));",
                  "pm.test('element suggested AF', () => pm.expect(item.suggestedOpinion).to.eql('AF'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{expertToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analysis-sheets/items/{{item1Id}}/criteria",
              "host": ["{{baseUrl}}"],
              "path": ["analysis-sheets", "items", "{{item1Id}}", "criteria"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criteria\": [\n    { \"label\": \"Forme\", \"opinion\": \"AF\" },\n    { \"label\": \"Fonctionnalité\", \"opinion\": \"AF\" },\n    { \"label\": \"Constitution\", \"opinion\": \"AF\" },\n    { \"label\": \"Conformité aux cahiers des charges\", \"opinion\": \"AF\" },\n    { \"label\": \"Exploitabilité\", \"opinion\": \"AF\" },\n    { \"label\": \"Autres conformités\", \"opinion\": \"NA\" }\n  ]\n}"
            },
            "description": "Full replace — the labels must match the grid exactly (accents included)."
          }
        },
        {
          "name": "Element 2 — one criterion unfavourable",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const sheet = pm.response.json();",
                  "const item = sheet.items.find((i) => i.id === pm.collectionVariables.get('item2Id'));",
                  "pm.test('worst criterion wins → AD', () => pm.expect(item.suggestedOpinion).to.eql('AD'));",
                  "pm.test('the delivery is suggested AD too', () => pm.expect(sheet.suggestedOpinion).to.eql('AD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{expertToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analysis-sheets/items/{{item2Id}}/criteria",
              "host": ["{{baseUrl}}"],
              "path": ["analysis-sheets", "items", "{{item2Id}}", "criteria"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criteria\": [\n    { \"label\": \"Forme\", \"opinion\": \"AF\" },\n    { \"label\": \"Fonctionnalité\", \"opinion\": \"AFR\", \"observation\": \"Cartouche a completer\" },\n    { \"label\": \"Constitution\", \"opinion\": \"AF\" },\n    { \"label\": \"Conformité aux cahiers des charges\", \"opinion\": \"AD\", \"observation\": \"Section d'acier insuffisante\" },\n    { \"label\": \"Exploitabilité\", \"opinion\": \"AF\" },\n    { \"label\": \"Autres conformités\", \"opinion\": \"NA\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "GUARD — submit before pronouncing → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('message counts the missing avis', () => pm.expect(pm.response.json().message).to.include('have no avis yet'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{expertToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analysis-sheets/{{sheetV1Id}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["analysis-sheets", "{{sheetV1Id}}", "submit"]
            }
          }
        },
        {
          "name": "Pronounce element 1 (AF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{expertToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analysis-sheets/items/{{item1Id}}",
              "host": ["{{baseUrl}}"],
              "path": ["analysis-sheets", "items", "{{item1Id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"opinion\": \"AF\",\n  \"observation\": \"Conforme\"\n}" }
          }
        },
        {
          "name": "Pronounce element 2 (AD)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('the delivery is still suggested AD', () => pm.expect(pm.response.json().suggestedOpinion).to.eql('AD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{expertToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analysis-sheets/items/{{item2Id}}",
              "host": ["{{baseUrl}}"],
              "path": ["analysis-sheets", "items", "{{item2Id}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"opinion\": \"AD\",\n  \"observation\": \"Plan a reprendre entierement\"\n}"
            },
            "description": "The expert may depart from the suggestion — the decision is theirs."
          }
        }
      ]
    },
    {
      "name": "2. Submit & reject → version 2",
      "item": [
        {
          "name": "GUARD — the chef de projet cannot submit → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.include('Only the author'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/analysis-sheets/{{sheetV1Id}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["analysis-sheets", "{{sheetV1Id}}", "submit"]
            }
          }
        },
        {
          "name": "GUARD — decide before submission → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.include('not been submitted'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analysis-sheets/{{sheetV1Id}}/decide",
              "host": ["{{baseUrl}}"],
              "path": ["analysis-sheets", "{{sheetV1Id}}", "decide"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"overallOpinion\": \"AD\"\n}" }
          }
        },
        {
          "name": "The expert submits",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
