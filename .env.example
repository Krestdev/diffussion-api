# Diffusion API — environment (copy to .env and fill in).

PORT=8000
DATABASE_URL=postgresql://user:password@localhost:5432/diffusion
# Origins of the UI ("*" = echo any origin, dev only). Credentials (the core's
# cookie) are allowed.
CORS_ORIGINS=*
APP_WEB_URL=http://localhost:4000

# --- CREAPP core: people sign in there -------------------------------------
# The core API (JWKS at /.well-known/jwks.json, directory at
# /api/v1/apps/self/directory). Local core API: http://localhost:4200.
CORE_URL=http://localhost:4200
# The `iss` of core tokens = the core's APP_URL (same value Besoin uses).
CORE_ISSUER=
# Diffusion's id in the core's app catalog (manifest.json "id").
CORE_APP_ID=diffusion
# The app key (cak_…) the core console gives Diffusion (Catalog › Diffusion ›
# API keys). Empty: no directory sync; people are copied from the session
# store at their first request.
CORE_APP_KEY=
# How often companies (= sites) and people are read from the core.
CORE_SYNC_SECONDS=60
# Sites made before the move to the core, matched to the core's companies:
# "<core company id>=<site id>,…" (otherwise the site with the company's name).
CORE_SITE_LINKS=
# The core's session store (same Redis as the core and Besoin).
REDIS_URL=redis://localhost:6379
# How long a person's roles are reused by the guard, seconds (0 = every call).
ACCESS_CACHE_SECONDS=30

# --- File storage (dochub) --------------------------------------------------
RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=
RUSTFS_PUBLIC_ENDPOINT=

# Seed only: a person already synced from the core who gets every role
# globally (tests).
SEED_ADMIN_EMAIL=
