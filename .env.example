NODE_ENV=development
PORT=8000
TZ=Africa/Douala
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/diffusion
# The core service: sign-in, companies, users (module.admin/creapp-core-api).
# CORE_URL is how this API reaches it; CORE_ISSUER is the admin console address (the core's APP_URL).
CORE_URL=http://localhost:4200
CORE_ISSUER=http://localhost:3200
# Diffusion's id in the core's app catalog (manifest.json "id").
CORE_APP_ID=diffusion
# Diffusion's key from the platform console (Apps → Diffusion → API keys). Not set: no directory sync
# (people are then copied from the session store at their first request).
CORE_APP_KEY=cak_ND7fRxVOh-lZrhKa5RskQFfmBNmMF9CPnIob1CZexUc
CORE_SYNC_SECONDS=60
# Companies made in Diffusion before it moved onto the core, matched to the core's:
# "<core company id>=<Diffusion company id>,…" (otherwise the company of the same name).
CORE_COMPANY_LINKS=
# The session store shared with the core (sessions and rights, read on every request).
REDIS_URL=redis://localhost:6379
# Comma-separated browser origins allowed to call the API with cookies ("*" echoes any origin, dev only).
CORS_ORIGINS=http://localhost:4000
# Seed (`npx prisma db seed`): a person already synced from the core who gets every role globally (tests).
SEED_ADMIN_EMAIL=

# Documents storage: dochub.krestdev.com in every environment, development included (no local
# storage server). Each environment has its own folder (S3_KEY_PREFIX). The storage must allow PUT
# and GET from every site that uploads (CORS: the UI's address).
S3_BUCKET=diffusion
S3_REGION=us-east-1
S3_ENDPOINT=https://dochub.krestdev.com
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Folder inside the bucket for this environment (the bucket is shared), e.g. diffusion-prod.
S3_KEY_PREFIX=diffusion-dev
# Only when browsers reach the storage at another address than the API does.
S3_PUBLIC_ENDPOINT=
# How long a person's roles are reused between requests (seconds, 0 = never).
ACCESS_CACHE_SECONDS=10

# The UI's address, for links in emails.
APP_URL=http://localhost:4000
# Where support requests are sent (help centre).
SUPPORT_EMAIL=
