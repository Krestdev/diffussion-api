// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @db.VarChar(100)

  userServices UserService[]

  @@map("service")
}

model User {
  // base attributes
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  refreshToken String?

  // state attributes
  status      UserStatus
  isVerified  Boolean
  isConnected Boolean

  // connected attributes
  userServices       UserService[]
  assignments        Assignment[]
  validations        Validation[]
  auditLogs          AuditLog[]
  dechargedDocuments Document[]    @relation("DocumentDecharge")

  // log trace attributes
  lastConnexion     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userInstructions  UserInstructions[]
  userNotifications UserNotification[]

  @@map("user")
}

enum UserStatus {
  ACTIF
  INACTIF
  BLOCKED
}

enum DocumentType {
  DOSSIER
  COURRIER
  FILE
}

model UserInstructions {
  userId        String
  instructionId String

  user        User        @relation(fields: [userId], references: [id])
  instruction Instruction @relation(fields: [instructionId], references: [id])

  action UserInstructionsActions

  @@id([userId, instructionId])
  @@map("user_instructions")
}

enum UserInstructionsActions {
  EXECUTANT
  SUPERVISEUR
}

model UserService {
  userId    String
  serviceId String

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([userId, serviceId])
  @@map("user_service")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  actions    String   @db.VarChar(10)
  datetime   DateTime
  entityId   String?
  entityType String?  @db.VarChar(10)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

model UserNotification {
  userId         String
  notificationId String
  isRed          Boolean @default(false)

  user         User         @relation(fields: [userId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id])

  @@id([userId, notificationId])
  @@map("user_notification")
}

model Notification {
  id         String  @id @default(uuid())
  userId     String
  documentId String?
  type       String  @db.VarChar(20)
  message    String?
  statut     String? @db.VarChar(10)
  canal      String? @db.VarChar(10)

  document          Document?          @relation(fields: [documentId], references: [id])
  userNotifications UserNotification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("notification")
}

model Document {
  id               String   @id @default(uuid())
  documentType     String   @db.VarChar(10)
  type             String?  @db.VarChar(10)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  parentDocumentId String?
  categoryId       String?
  correspondantId  String?

  // status/canal widened from VarChar(10): the BAD's actual vocabulary
  // ("Enregistré", "En vérification", "Dépôt physique", ...) doesn't fit
  // 10 chars — was an artifact of an earlier reasonable-default guess.
  status    String?   @db.VarChar(30)
  date      DateTime?
  libelle   String?   @db.VarChar(100)
  directory Int?
  reference String?   @db.VarChar(30)
  canal     String?   @db.VarChar(30)
  copies    Int?
  Version   Int?

  // Courrier workflow fields (RG-COU-003..007) — see courrier.constants.ts
  // for the status/action vocabulary these support.
  direction              String?   @db.VarChar(10)
  modificationAuthorized Boolean   @default(false)
  transmittedOn          DateTime?
  scanUrl                String?

  // Décharge (§10.2.5): recorded independently of the status state machine
  // — it's proof of physical handover, not a lifecycle transition.
  dechargeAt     DateTime?
  dechargeById   String?
  dechargeCachet Boolean?
  dateReception  DateTime?

  // Dossier workflow fields (RG-DOS-001..008) — see dossier.constants.ts.
  // numero: auto-generated reference number, set once at creation.
  // priorite: reuses Instruction.priorite's vocabulary/length.
  // siteId: was flagged unresolved (⚠) — added as a direct FK, the same
  // way `direction` was added for Courrier, rather than derived through
  // Assignment (no dossier "owner" user concept exists to derive it from).
  numero   String? @unique @db.VarChar(30)
  priorite String? @db.VarChar(20)
  siteId   String?

  parent   Document?  @relation("DocumentHierarchy", fields: [parentDocumentId], references: [id])
  children Document[] @relation("DocumentHierarchy")

  category      Category?      @relation(fields: [categoryId], references: [id])
  correspondant Correspondant? @relation(fields: [correspondantId], references: [id])
  dechargeBy    User?          @relation("DocumentDecharge", fields: [dechargeById], references: [id])
  site          Site?          @relation(fields: [siteId], references: [id])

  instructions     Instruction[]
  notifications    Notification[]
  instanceCircuits InstanceCircuit[]

  @@map("document")
}

model Instruction {
  id           String    @id @default(uuid())
  userId       String
  userId2      String?
  documentId   String
  libelle      String    @db.VarChar(100)
  priorite     String?   @db.VarChar(20)
  echeance     DateTime?
  statut       String    @db.VarChar(30)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt
  parentId     String?
  validationId String?

  document         Document           @relation(fields: [documentId], references: [id])
  parent           Instruction?       @relation("InstructionDependency", fields: [parentId], references: [id])
  children         Instruction[]      @relation("InstructionDependency")
  validation       Validation?        @relation(fields: [validationId], references: [id])
  userInstructions UserInstructions[]

  @@map("instruction")
}

model Category {
  id                String    @id @default(uuid())
  libelle           String?   @db.VarChar(100)
  type              String?   @db.VarChar(10)
  dureeConservation Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt

  documents Document[]

  @@map("category")
}

model Correspondant {
  id        String   @id @default(uuid())
  names     String?  @db.VarChar(100)
  type      String?  @db.VarChar(10)
  ville     String?  @db.VarChar(100)
  status    String?  @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents        Document[]
  instanceCircuits InstanceCircuit[]

  @@map("correspondant")
}

model Validation {
  id                String    @id @default(uuid())
  decision          String?
  instanceCircuitId String?
  motif             String?
  dateDecision      DateTime?
  userId            String

  user            User             @relation(fields: [userId], references: [id])
  instanceCircuit InstanceCircuit? @relation(fields: [instanceCircuitId], references: [id])
  instructions    Instruction[]

  @@map("validation")
}

model Site {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  assignments Assignment[]
  documents   Document[]

  @@map("site")
}

model Assignment {
  id     String @id @default(uuid())
  userId String
  siteId String

  user  User   @relation(fields: [userId], references: [id])
  site  Site   @relation(fields: [siteId], references: [id])
  roles Role[]

  @@map("assignment")
}

model Permission {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  names     String?   @db.VarChar(10)

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id             String  @id @default(uuid())
  assignmentId   String
  etapeCircuitId String?
  // Role had no name/label field at all — added for the RBAC skeleton so
  // roles are addressable (e.g. seeding/checking "Admin").
  name           String? @db.VarChar(50)

  assignment      Assignment       @relation(fields: [assignmentId], references: [id])
  rolePermissions RolePermission[]
  etapesCircuit   EtapeCircuit[]
  etapeCircuit    EtapeCircuit?    @relation("RoleEtapeCircuitLegacy", fields: [etapeCircuitId], references: [id])
  circuits        Circuit[]

  @@map("role")
}

model RolePermission {
  permissionId String
  roleId       String

  permission Permission @relation(fields: [permissionId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([permissionId, roleId])
  @@map("role_permission")
}

model Circuit {
  id            String  @id @default(uuid())
  roleId        String?
  name          String? @db.VarChar(100)
  typeDossierId Int?

  role             Role?             @relation(fields: [roleId], references: [id])
  etapesCircuit    EtapeCircuit[]
  instanceCircuits InstanceCircuit[]

  @@map("circuit")
}

model EtapeCircuit {
  id                   String  @id @default(uuid())
  circuitId            String
  order                Int
  typeAction           String? @db.VarChar(100)
  delaiMaxH            Int?
  parentEtapeCircuitId String?
  docs                 String? @db.VarChar(10)
  state                String? @db.VarChar(10)
  condition            String?
  roleId               String?

  circuit                      Circuit                       @relation(fields: [circuitId], references: [id])
  parentEtape                  EtapeCircuit?                 @relation("EtapeCircuitChain", fields: [parentEtapeCircuitId], references: [id])
  childEtapes                  EtapeCircuit[]                @relation("EtapeCircuitChain")
  role                         Role?                         @relation(fields: [roleId], references: [id])
  roleLegacy                   Role[]                        @relation("RoleEtapeCircuitLegacy")
  instancesCurrent             InstanceCircuit[]
  etapeCircuitInstanceCircuits EtapeCircuitInstanceCircuit[]

  @@map("etape_circuit")
}

model InstanceCircuit {
  id              String  @id @default(uuid())
  documentId      String
  circuitId       String
  etapeCircuitId  String
  correspondantId String?

  document         Document                      @relation(fields: [documentId], references: [id])
  circuit          Circuit                       @relation(fields: [circuitId], references: [id])
  etapeCourante    EtapeCircuit                  @relation(fields: [etapeCircuitId], references: [id])
  correspondant    Correspondant?                @relation(fields: [correspondantId], references: [id])
  etapesHistorique EtapeCircuitInstanceCircuit[]
  validations      Validation[]

  @@map("instance_circuit")
}

model EtapeCircuitInstanceCircuit {
  id                String @id @default(uuid())
  etapeCircuitId    String
  instanceCircuitId String

  etapeCircuit    EtapeCircuit    @relation(fields: [etapeCircuitId], references: [id])
  instanceCircuit InstanceCircuit @relation(fields: [instanceCircuitId], references: [id])

  @@map("etape_circuit_instance_circuit")
}
