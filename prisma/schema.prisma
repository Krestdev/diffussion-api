// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @db.VarChar(100)

  userServices UserService[]

  @@map("service")
}

model User {
  // base attributes
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  refreshToken String?

  // state attributes
  status      UserStatus
  isVerified  Boolean    @default(false)
  isConnected Boolean    @default(false)

  // connected attributes
  userServices       UserService[]
  assignments        Assignment[]
  validations        Validation[]
  auditLogs          AuditLog[]
  dechargedDocuments Document[]    @relation("DischargedBy")

  // log trace attributes
  lastlogin         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userInstructions  UserInstructions[]
  userNotifications UserNotification[]

  @@map("user")
}

enum UserStatus {
  ACTIF
  BLOCKED
}

enum DocumentType {
  DOSSIER
  COURRIER
  FILE
}

enum UserInstructionsStatus {
  PENDING
  EXECUTED
  CANCELLED
}

enum NotificationStatus {
  NOT_READ
  READ
  ARCHIVED
}

model UserInstructions {
  userId        String
  instructionId String

  user        User                    @relation(fields: [userId], references: [id])
  instruction Instruction             @relation(fields: [instructionId], references: [id])
  status      UserInstructionsStatus
  action      UserInstructionsActions

  @@id([userId, instructionId])
  @@map("user_instructions")
}

enum UserInstructionsActions {
  EXECUTANT
  SUPERVISEUR
}

model UserService {
  userId    String
  serviceId String

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@id([userId, serviceId])
  @@map("user_service")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  actions    String   @db.VarChar(10)
  datetime   DateTime
  entityId   String?
  entityType String?  @db.VarChar(10)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

model UserNotification {
  userId         String
  notificationId String
  statut         NotificationStatus
  user           User               @relation(fields: [userId], references: [id])
  notification   Notification       @relation(fields: [notificationId], references: [id])

  @@id([userId, notificationId])
  @@map("user_notification")
}

enum CanalType {
  EMAIL
  NOTIFICATION
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  documentId String?
  type       String    @db.VarChar(20)
  message    String?
  canal      CanalType

  document          Document?          @relation(fields: [documentId], references: [id])
  userNotifications UserNotification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("notification")
}

enum DocumentStatus {
  ARCHIVED
  ACTIVE
  REJECTED
}

model Document {
  id              String         @id @default(uuid())
  documentType    DocumentType
  isDocument      Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  parentId        String?
  categoryId      String?
  correspondantId String?
  status          DocumentStatus
  date            DateTime?
  label           String?        @db.VarChar(100)
  directory       Int?
  reference       String?        @db.VarChar(30)
  canal           String?        @db.VarChar(30)
  copies          Int?
  version         Int?

  // ENTRANT OU SORTANT
  direction              String?   @db.VarChar(10)
  modificationAuthorized Boolean   @default(false)
  transmittedOn          DateTime?
  scanUrl                String?

  // Décharge (§10.2.5): recorded independently of the status state machine
  // — it's proof of physical handover, not a lifecycle transition.
  dischargedAt    DateTime?
  dischargedById  String?
  dischargedStamp Boolean?
  receivedAt      DateTime?
  number          String?   @unique @db.VarChar(30)
  siteId          String?

  parent   Document?  @relation("DocumentHierarchy", fields: [parentId], references: [id])
  children Document[] @relation("DocumentHierarchy")

  category      Category?      @relation(fields: [categoryId], references: [id])
  correspondant Correspondant? @relation(fields: [correspondantId], references: [id])
  site          Site?          @relation(fields: [siteId], references: [id])
  dischargedBy  User?          @relation("DischargedBy", fields: [dischargedById], references: [id])

  instructions     Instruction[]
  notifications    Notification[]
  circuitInstances CircuitInstance[]

  @@map("document")
}

enum InstructionStatus {
  EXECUTED
  CANCELLED
}

enum InstructionPriorite {
  LOW
  MEDIUM
  HIGH
}

model Instruction {
  id           String              @id @default(uuid())
  userId       String
  userId2      String?
  documentId   String
  label        String              @db.VarChar(100)
  priorite     InstructionPriorite
  dateline     DateTime?
  statut       InstructionStatus
  createdAt    DateTime            @default(now())
  updatedAt    DateTime?           @updatedAt
  parentId     String?
  validationId String?

  document         Document           @relation(fields: [documentId], references: [id])
  parent           Instruction?       @relation("InstructionDependency", fields: [parentId], references: [id])
  children         Instruction[]      @relation("InstructionDependency")
  validation       Validation?        @relation(fields: [validationId], references: [id])
  userInstructions UserInstructions[]

  @@map("instruction")
}

model Category {
  id        String    @id @default(uuid())
  label     String?   @db.VarChar(100)
  type      String?   @db.VarChar(10)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  documents Document[]

  @@map("category")
}

model Correspondant {
  id        String   @id @default(uuid())
  name      String?  @db.VarChar(100)
  type      String?  @db.VarChar(10)
  // town     String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents        Document[]
  circuitInstances CircuitInstance[]

  @@map("correspondant")
}

model Validation {
  id                String    @id @default(uuid())
  decision          String?
  circuitInstanceId String?
  motif             String?
  dateDecision      DateTime?
  userId            String

  user            User             @relation(fields: [userId], references: [id])
  circuitInstance CircuitInstance? @relation(fields: [circuitInstanceId], references: [id])
  instructions    Instruction[]

  @@map("validation")
}

enum SiteStatus {
  ACTIVE
  BLOCKED
}

model Site {
  id        String     @id @default(uuid())
  name      String     @db.VarChar(100)
  status    SiteStatus
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  assignments Assignment[]
  documents   Document[]

  @@map("site")
}

model Assignment {
  id     String @id @default(uuid())
  userId String
  siteId String

  user  User   @relation(fields: [userId], references: [id])
  site  Site   @relation(fields: [siteId], references: [id])
  roles Role[]

  @@map("assignment")
}

model Permission {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  name      String?   @db.VarChar(10)

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id            String  @id @default(uuid())
  assignmentId  String
  circuitStepId String?
  name          String? @db.VarChar(50)

  assignment      Assignment       @relation(fields: [assignmentId], references: [id])
  rolePermissions RolePermission[]
  circuitSteps    CircuitStep[]
  circuitStep     CircuitStep?     @relation("RoleEtapeCircuitLegacy", fields: [circuitStepId], references: [id])
  circuits        Circuit[]

  @@map("role")
}

model RolePermission {
  permissionId String
  roleId       String

  permission Permission @relation(fields: [permissionId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([permissionId, roleId])
  @@map("role_permission")
}

model Circuit {
  id             String  @id @default(uuid())
  roleId         String?
  name           String? @db.VarChar(100)
  documentTypeId Int?

  role             Role?             @relation(fields: [roleId], references: [id])
  circuitSteps     CircuitStep[]
  circuitInstances CircuitInstance[]

  @@map("circuit")
}

enum CircuitStateStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CircuitStep {
  id                  String             @id @default(uuid())
  circuitId           String
  order               Int
  actionType          String?            @db.VarChar(100)
  parentCircuitStepId String?
  state               CircuitStateStatus
  condition           String?
  roleId              String?

  circuit                     Circuit                      @relation(fields: [circuitId], references: [id])
  parentCircuitStep           CircuitStep?                 @relation("CircuitStepChain", fields: [parentCircuitStepId], references: [id])
  childCircuitSteps           CircuitStep[]                @relation("CircuitStepChain")
  role                        Role?                        @relation(fields: [roleId], references: [id])
  roleLegacy                  Role[]                       @relation("RoleEtapeCircuitLegacy")
  circuitInstancesCurrent     CircuitInstance[]
  circuitStepInstanceCircuits CircuitStepInstanceCircuit[]

  @@map("circuit_step")
}

model CircuitInstance {
  id              String  @id @default(uuid())
  documentId      String
  circuitId       String
  circuitStepId   String
  correspondantId String?

  document           Document                     @relation(fields: [documentId], references: [id])
  circuit            Circuit                      @relation(fields: [circuitId], references: [id])
  currentCircuitStep CircuitStep                  @relation(fields: [circuitStepId], references: [id])
  correspondant      Correspondant?               @relation(fields: [correspondantId], references: [id])
  circuitStepHistory CircuitStepInstanceCircuit[]
  validations        Validation[]

  @@map("instance_circuit")
}

model CircuitStepInstanceCircuit {
  id                String          @id @default(uuid())
  circuitStepId     String
  circuitInstanceId String
  circuitStep       CircuitStep     @relation(fields: [circuitStepId], references: [id])
  circuitInstance   CircuitInstance @relation(fields: [circuitInstanceId], references: [id])

  @@map("circuit_step_instance_circuit")
}
