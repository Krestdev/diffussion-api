// Diffusion — domain model
//
// Refined against docs/BUSINESS ANALYSIS DOCUMENT - DIFFUSION.pdf (BAD) and the
// Entity Relationship Diagram. Organized around the BAD's five sub-domains:
// Organisation, Dossiers, Correspondance, Collaboration, Administration.
//
// Corrections made vs the previous schema (kept here for review traceability):
// - Dossier and Courrier are split into first-class models (were a single
//   `Document` table discriminated by `documentType`). BAD 6.3.1/6.5/7.2 treat
//   them as distinct aggregates with different lifecycles and attributes, and
//   the dossier controller already assumed `/dossiers/:id/courriers` — a
//   sub-collection, not a self-join filtered by type.
// - `Livrable` did not exist as a model at all (7.4) despite a `deliverable`
//   module already scaffolded on the API — added, versioned (RG-LIV-007).
// - `Role` was owned by a single `Assignment` (one bespoke role per
//   site-assignment). BAD 6.1.1/9.7 and RG-ORG-003 describe roles as reusable,
//   named templates a user can hold several of at once — switched to a plain
//   User<->Role many-to-many (`UserRole`), since scoped to a site (or global).
// - Several free-text fields were capped at `VarChar(10)`, too short for real
//   values already in use ("Administration publique", "DOSSIER_TRANSMIT",
//   "Modification") — widened or left unbounded.
// - `Category` was missing `retentionMonths` despite RG-ARC-001 ("chaque
//   catégorie de dossier peut être associée à une durée de conservation").
// - `Correspondent` was missing address/contact fields listed in 7.5.3.
// - `Site` had no responsible user despite RG the frontend already models
//   ("Responsable du site").
// - Instruction dependency (RG-LIV-006) is "one or more", modeled as a
//   self many-to-many instead of a single `parentId`.
// - Added `Delegation` (7.6.6) and a small set of admin referentials
//   (CorrespondentType, CourrierNature, Canal) that the BAD lists
//   under "Référentiels métier" (6.4) and that the frontend already routes to
//   under Administration > Paramètres.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organisation domain (BAD 6.1.1 / 9)
// ---------------------------------------------------------------------------

/// Single-use, short-lived password reset grant (only the SHA-256 digest of
/// the token is stored — the token itself only ever lives in the user's
/// reset link).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// How the administration screens present an account (A·2). A label kept
/// with the account; the rights themselves still come from its roles.
enum AccessProfile {
  SUPER_ADMIN
  COMPANY_ADMIN
  USER
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  refreshToken String?

  /// Matricule (9.2.2)
  registrationNumber String? @unique @db.VarChar(30)
  /// Fonction — job title, informational only, does not grant rights (9.3)
  function           String?
  phone              String? @db.VarChar(30)

  status          UserStatus    @default(ACTIVE)
  accessProfile   AccessProfile @default(USER)
  /// When and by whom the account was last suspended (A·13); cleared when
  /// it is reactivated.
  deactivatedAt   DateTime?
  deactivatedById String?
  isVerified      Boolean       @default(false)
  isConnected     Boolean       @default(false)
  lastLogin       DateTime?

  /// The one site the user belongs to (RG-ORG-001, revised: one site per
  /// user). Null for platform users (super-admins), whose roles are global.
  siteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: a site can't be deleted while users still belong to it.
  site               Site?        @relation("SiteUsers", fields: [siteId], references: [id], onDelete: Restrict)
  deactivatedBy      User?        @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivatedUsers   User[]       @relation("UserDeactivatedBy")
  archivedRoles      Role[]       @relation("RoleArchivedBy")
  invitationsSent    Invitation[] @relation("InvitationInvitedBy")
  invitationAccepted Invitation?  @relation("InvitationUser")

  userRoles               UserRole[]
  userInstructions        UserInstructions[]
  userNotifications       UserNotification[]
  validations             Validation[]
  subscriptions           InstructionSubscription[]
  notificationPreferences NotificationPreference[]

  managedSites               Site[]               @relation("SiteManager")
  responsibleDossiers        Dossier[]            @relation("DossierResponsible")
  responsibleProjects        Project[]            @relation("ProjectResponsible")
  createdDossiers            Dossier[]            @relation("DossierCreatedBy")
  createdCourriers           Courrier[]           @relation("CourrierCreatedBy")
  dischargedCourriers        Courrier[]           @relation("CourrierDischargedBy")
  ownedCourriers             Courrier[]           @relation("CourrierOwner")
  supervisedCourriers        Courrier[]           @relation("CourrierSupervisor")
  proposedCourriers          Courrier[]           @relation("CourrierProposedBy")
  dispatchValidatedCourriers Courrier[]           @relation("CourrierDispatchValidatedBy")
  approvedCourriers          Courrier[]           @relation("CourrierApprovedBy")
  validatedAnalysisSheets    AnalysisSheet[]      @relation("AnalysisSheetValidator")
  transmittedCourriers       Courrier[]           @relation("CourrierTransmittedBy")
  signedCourriers            Courrier[]           @relation("CourrierSignedBy")
  createdInstructions        Instruction[]        @relation("InstructionCreatedBy")
  createdLivrables           Livrable[]           @relation("LivrableCreatedBy")
  uploadedDocuments          Document[]           @relation("DocumentUploadedBy")
  ownedDocuments             Document[]           @relation("DocumentOwner")
  delegationsGiven           Delegation[]         @relation("DelegationDelegant")
  delegationsReceived        Delegation[]         @relation("DelegationDelegataire")
  dossierAccesses            DossierAccess[]
  courrierAccesses           CourrierAccess[]
  projectAccesses            ProjectAccess[]
  contractAccesses           ContractAccess[]
  responsibleContracts       Contract[]           @relation("ContractResponsible")
  documentAccesses           DocumentAccess[]
  passwordResetTokens        PasswordResetToken[]
  analysisSheets             AnalysisSheet[]      @relation("AnalysisSheetAuthor")
  analysisDecisions          AnalysisSheet[]      @relation("AnalysisSheetDecidedBy")

  @@index([siteId])
  @@map("user")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

/// A geographic/organisational location (9.5). Owns dossiers as their
/// "site propriétaire" (RG-DOS-003) and has a responsible user.
model Site {
  id            String     @id @default(uuid())
  code          String     @unique @db.VarChar(30)
  name          String     @db.VarChar(100)
  city          String?    @db.VarChar(100)
  status        SiteStatus @default(ACTIVE)
  responsibleId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  responsible      User?                       @relation("SiteManager", fields: [responsibleId], references: [id])
  users            User[]                      @relation("SiteUsers")
  roles            Role[]
  effetTypes       EffetType[]
  canals           Canal[]
  projects         Project[]
  analysisCriteria AnalysisCriterionTemplate[]
  analysisSettings AnalysisSiteSettings?
  correspondents   Correspondent[]
  userRoles        UserRole[]
  dossiers         Dossier[]
  delegations      Delegation[]
  invitations      Invitation[]

  @@map("site")
}

/// Reusable named permission set ("Exécutant", "Administrateur", ...).
/// Reusable template (RG-ORG-003: cumulative). Held per site or globally — see UserRole.
/// Global (`siteId` null): made by a platform administrator, usable on
/// every site. Otherwise a role of that site only, made and managed by the
/// site's responsible, and held by that site's users only.
model Role {
  id           String    @id @default(uuid())
  code         String    @unique @db.VarChar(30)
  name         String    @db.VarChar(50)
  description  String?
  siteId       String?
  /// Archived (A·9): held by nobody any more, never offered, restorable.
  /// A role is never deleted.
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  site            Site?            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  archivedBy      User?            @relation("RoleArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  invitations     Invitation[]
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  delegations     Delegation[]

  /// A name is unique among the global roles and within each site (NULLS
  /// NOT DISTINCT, see the migration).
  @@unique([siteId, name])
  @@map("role")
}

/// A role held by a user: at the user's own site (`siteId` = User.siteId),
/// or globally (`siteId` null) for a platform user, who has no site. A
/// global grant gives the role's permissions everywhere. The unique key
/// treats null as a value (NULLS NOT DISTINCT, see the migration), so a
/// global grant can't be duplicated either.
model UserRole {
  id     String  @id @default(uuid())
  userId String
  roleId String
  siteId String?

  user User  @relation(fields: [userId], references: [id])
  role Role  @relation(fields: [roleId], references: [id])
  // Restrict: SetNull (the default for an optional relation) would turn a
  // site grant into a global one.
  site Site? @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, siteId])
  @@index([siteId, roleId])
  @@map("user_role")
}

/// A single grantable action (e.g. DOSSIER_CLOSE) — see PermissionCode.
model Permission {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  description String?
  /// Listed in the role screens (GET /permissions) or hidden from them. A
  /// hidden permission is still checked wherever a route requires it.
  display     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  permissionId String
  roleId       String

  permission Permission @relation(fields: [permissionId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  @@id([permissionId, roleId])
  @@map("role_permission")
}

/// Temporary handover of a responsibility to another collaborator (7.6.6).
model Delegation {
  id             String   @id @default(uuid())
  delegantId     String
  delegataireId  String
  /// What is handed over: one role, at one site. The delegataire is treated
  /// as holding `role` at `site` while the window is open.
  roleId         String
  siteId         String
  /// Free-text label kept for the register ("Responsable de dossier"), no
  /// longer what drives the grant.
  responsibility String?  @db.VarChar(100)
  startDate      DateTime
  endDate        DateTime
  reason         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  delegant    User @relation("DelegationDelegant", fields: [delegantId], references: [id])
  delegataire User @relation("DelegationDelegataire", fields: [delegataireId], references: [id])
  role        Role @relation(fields: [roleId], references: [id])
  site        Site @relation(fields: [siteId], references: [id])

  @@index([delegataireId, roleId, siteId])
  @@map("delegation")
}

// ---------------------------------------------------------------------------
// Administration referentials (BAD 6.4)
// ---------------------------------------------------------------------------

/// Retention-bearing document classification (7.1.5 "Catégorie").
model Category {
  id              String   @id @default(uuid())
  label           String   @unique @db.VarChar(100)
  code            String?  @unique @db.VarChar(30)
  description     String?
  /// RG-ARC-001: inherited by a dossier at creation from its category.
  retentionMonths Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dossiers Dossier[]

  @@map("category")
}

/// Kind of effet: courrier, bordereau de transmission, matière ou spécimen,
/// document, support numérique, dossier complet... Global (`siteId` null,
/// made by a platform administrator) or a site's own (made by its
/// responsible), like roles.
model EffetType {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(100)
  /// Physical object: quantity, condition, packaging, location, return.
  isPhysical    Boolean  @default(false)
  /// Can list the effets it accompanies (a bordereau de transmission).
  canListEffets Boolean  @default(false)
  /// An inactive type is no longer offered for new effets.
  active        Boolean  @default(true)
  siteId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site      Site?      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  courriers Courrier[]

  /// A name is unique among the global types and within each site (NULLS
  /// NOT DISTINCT, see the migration).
  @@unique([siteId, name])
  @@map("effet_type")
}

/// "Nature du courrier" (10.2, a courrier registration field distinct from
/// direction/canal — e.g. rapport, demande, réponse administrative...).
model CourrierNature {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courriers Courrier[]

  @@map("courrier_nature")
}

/// Communication channel referential (6.4), used by Courrier.
/// Belongs to one site: only that site's effets use it (unique per site).
model Canal {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  siteId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site      Site       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  courriers Courrier[]

  @@unique([siteId, name])
  @@map("canal")
}

model CorrespondentType {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  correspondents Correspondent[]

  @@map("correspondent_type")
}

enum CorrespondentStatus {
  ACTIVE
  INACTIVE
}

/// Referential of external parties (7.5). May be sender, recipient, or both.
model Correspondent {
  id          String              @id @default(uuid())
  code        String              @unique @db.VarChar(30)
  name        String              @db.VarChar(150)
  typeId      String?
  address     String?
  city        String?             @db.VarChar(100)
  country     String?             @db.VarChar(100)
  email       String?             @db.VarChar(150)
  phone       String?             @db.VarChar(30)
  mainContact String?             @db.VarChar(150)
  status      CorrespondentStatus @default(ACTIVE)
  /// Belongs to one site: only that site's effets use it.
  siteId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  site            Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  type            CorrespondentType? @relation(fields: [typeId], references: [id])
  courriers       Courrier[]
  maitreOuvrageOf Project[]          @relation("ProjectMaitreOuvrage")
  clientOf        Contract[]         @relation("ContractClient")

  @@index([siteId])
  @@map("correspondent")
}

// ---------------------------------------------------------------------------
// Dossiers domain — root aggregate (BAD 6.2 / 7.1)
// ---------------------------------------------------------------------------

enum DossierPriority {
  URGENT
  NORMAL
  LOW
}

enum DossierConfidentiality {
  PUBLIC
  RESTRICTED
}

enum DossierStatus {
  OPEN
  IN_PROGRESS
  PENDING
  LATE
  CLOSED
  ARCHIVED
}

/// The Dossier is the root aggregate of the whole domain (7.1.1): every
/// courrier, instruction, livrable and document is ultimately attached to one.
model Dossier {
  id              String                 @id @default(uuid())
  /// RG-DOS-002: unique, system-generated.
  number          String                 @unique @db.VarChar(30)
  title           String                 @db.VarChar(200)
  description     String?
  categoryId      String?
  /// Optional grouping of dossiers under a wider project/programme.
  projectId       String?
  /// The contract this dossier is carried out under, if any.
  contractId      String?
  /// RG-DOS-003: exactly one owning site.
  siteId          String
  /// RG-DOS-004: always has a responsible at any instant.
  responsibleId   String?
  priority        DossierPriority        @default(NORMAL)
  confidentiality DossierConfidentiality @default(PUBLIC)
  status          DossierStatus          @default(OPEN)
  /// 0-100, derived from instruction completion; stored for fast listing.
  progress        Int                    @default(0)
  keywords        String[]               @default([])

  openedAt       DateTime  @default(now())
  /// Target completion date; past it, an active dossier turns LATE.
  dueDate        DateTime?
  closedAt       DateTime?
  archivedAt     DateTime?
  /// Why the dossier was archived (given when archiving).
  archiveReason  String?
  /// RG-ARC-001: openedAt + the category's retentionMonths, fixed at
  /// creation (recomputed if the category changes). Null = no retention rule.
  retentionUntil DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category    Category? @relation(fields: [categoryId], references: [id])
  project     Project?  @relation(fields: [projectId], references: [id])
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  site        Site      @relation(fields: [siteId], references: [id])
  responsible User?     @relation("DossierResponsible", fields: [responsibleId], references: [id])
  createdBy   User?     @relation("DossierCreatedBy", fields: [createdById], references: [id])

  courriers      Courrier[]
  instructions   Instruction[]
  documents      Document[]
  notifications  Notification[]
  /// Per-user view/edit access on top of `confidentiality` (RESTRICTED
  /// dossiers are otherwise only visible to their responsible/creator).
  accesses       DossierAccess[]
  analysisSheets AnalysisSheet[]

  @@map("dossier")
}

/// A wider project/programme a dossier can optionally be tagged under —
/// purely organisational, carries no workflow of its own.
model Project {
  id              String        @id @default(uuid())
  name            String        @unique @db.VarChar(200)
  /// "Réf Projet" on an analysis sheet.
  reference       String?       @db.VarChar(50)
  /// "Mode" (ex. marché public, gré à gré...).
  mode            String?       @db.VarChar(100)
  /// Maître d'ouvrage: the party the project is carried out for (ex. Port
  /// Autonome de Douala) — an external correspondent.
  maitreOuvrageId String?
  /// Who answers for the project.
  responsibleId   String?
  /// The site it belongs to: managed by that site's responsible (or a
  /// platform administrator), seen by that site's users only. Its dossiers
  /// and effets are on that site; its contracts follow it.
  siteId          String
  /// ACTIVE -> CLOSED -> ARCHIVED; closedAt / archivedAt record when.
  status          ProjectStatus @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  closedAt        DateTime?
  archivedAt      DateTime?
  /// Why the project was archived (given when archiving).
  archiveReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  maitreOuvrage  Correspondent?  @relation("ProjectMaitreOuvrage", fields: [maitreOuvrageId], references: [id])
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  responsible    User?           @relation("ProjectResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  dossiers       Dossier[]
  contracts      Contract[]
  courriers      Courrier[]
  analysisSheets AnalysisSheet[]
  /// Who may open the project; nobody listed = everyone (see ProjectAccess).
  accesses       ProjectAccess[]

  @@index([status])
  @@index([responsibleId])
  @@index([siteId])
  @@map("project")
}

enum ProjectStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

/// A contract (marché) a set of dossiers is carried out under. Optionally
/// part of a project; a dossier under a contract belongs to that contract's
/// project.
model Contract {
  id              String         @id @default(uuid())
  /// System-generated reference (CT-xxxxxx).
  number          String         @unique @db.VarChar(30)
  title           String         @db.VarChar(200)
  /// The contract's own reference, e.g. its marché number.
  reference       String?        @db.VarChar(100)
  description     String?
  projectId       String?
  status          ContractStatus @default(ACTIVE)
  type            ContractType?
  amount          Decimal?       @db.Decimal(15, 2)
  signedAt        DateTime?
  /// Reference of the tender (appel d'offres) the contract came from.
  tenderReference String?        @db.VarChar(100)
  /// The party the contract is carried out for — a correspondent.
  clientId        String?
  responsibleId   String?
  startDate       DateTime?
  endDate         DateTime?
  archivedAt      DateTime?
  archiveReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project        Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client         Correspondent?   @relation("ContractClient", fields: [clientId], references: [id])
  responsible    User?            @relation("ContractResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  dossiers       Dossier[]
  courriers      Courrier[]
  documents      Document[]
  instructions   Instruction[]    @relation("InstructionContract")
  /// Who may open the contract; nobody listed = everyone (see ContractAccess).
  accesses       ContractAccess[]
  analysisSheets AnalysisSheet[]

  @@index([projectId])
  @@index([status])
  @@map("contract")
}

enum ContractStatus {
  ACTIVE
  ARCHIVED
}

enum ContractType {
  MOE
  AMO
  TRAVAUX
  ETUDES
  CONTROLE
  AUTRE
}

/// A user allowed to open a project. A project nobody is listed on is open
/// to everyone; its responsible and platform administrators always may.
model ProjectAccess {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_access")
}

/// Same as ProjectAccess, for a contract.
model ContractAccess {
  contractId String
  userId     String
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contractId, userId])
  @@index([userId])
  @@map("contract_access")
}

/// Explicit per-user grant on a dossier, on top of its `confidentiality`.
/// One row per (dossier, user); absence of a row means no explicit grant.
model DossierAccess {
  id        String   @id @default(uuid())
  dossierId String
  userId    String
  canView   Boolean  @default(true)
  canEdit   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dossierId, userId])
  @@map("dossier_access")
}

enum CourrierDirection {
  ENTRANT
  SORTANT
}

/// Unified status covering both directions (BAD 7.2.4): an entrant courrier
/// only ever reaches RECU..ARCHIVE; a sortant one additionally cycles through
/// the BROUILLON..ENVOYE drafting states before ENVOYE/ARCHIVE.
enum CourrierStatus {
  RECU
  ENREGISTRE
  TRANSMIS
  EN_TRAITEMENT
  EN_ATTENTE
  BROUILLON
  /// An entrant whose dispatching (project, contract or dossier) was
  /// proposed by someone without the dispatch permission: waits for the
  /// Dispatching corridor to validate it -> TRANSMIS.
  EN_ATTENTE_TRANSMISSION
  /// An entrant dispatched (project + contract or dossier known), not yet
  /// handed to its designated responsible: POST /courriers/:id/transmit
  /// -> TRANSMIS.
  AFFECTE
  /// Submitted, awaiting its validator's decision (the dossier's
  /// responsible, or the site's) — VALIDE or A_CORRIGER.
  EN_ATTENTE_VALIDATION
  A_CORRIGER
  VALIDE
  /// A sortant whose signed scan was recorded (POST /courriers/:id/sign).
  SIGNE
  PRET_A_ENVOYER
  ENVOYE
  /// A sent sortant whose discharged bordereau came back.
  DECHARGE
  ANNULE
  CLOTURE
  ARCHIVE
}

/// A correspondence event belonging to exactly one dossier (7.2, RG-COU-001).
/// A sortant draft may be created with only its subject and attached to its
/// dossier later: `dossierId` is null only while BROUILLON.
model Courrier {
  id              String            @id @default(uuid())
  /// System-generated internal registration number (10.2.4.2).
  number          String            @unique @db.VarChar(30)
  dossierId       String?
  projectId       String?
  contractId      String?
  supervisorId    String?
  direction       CourrierDirection
  correspondentId String?
  natureId        String?
  canalId         String?
  subject         String            @db.VarChar(255)
  /// Reference as printed on the physical courrier itself (may differ from
  /// our internal `number`).
  reference       String?           @db.VarChar(60)
  status          CourrierStatus    @default(RECU)
  /// A sortant's text, as written by its author.
  body            String?
  copies          Int?
  receivedAt      DateTime?
  sentAt          DateTime?
  scanUrl         String?

  /// What kind of effet this is (courrier, bordereau, spécimen...). Set to
  /// the global "Courrier" type when none is given.
  typeId   String?
  /// The bordereau de transmission this effet came with, if any.
  parentId String?

  // Physical effets only (EffetType.isPhysical).
  quantity            Int?
  physicalDescription String?
  conditionOnReceipt  String?   @db.VarChar(255)
  packaging           String?   @db.VarChar(255)
  storageLocation     String?   @db.VarChar(255)
  returnExpected      Boolean   @default(false)
  returnedAt          DateTime?

  // Décharge (10.2.5): recorded independently of the status state machine —
  // it's proof of physical handover, not a lifecycle transition.
  dischargeRequested Boolean   @default(false)
  dischargedAt       DateTime?
  dischargedById     String?
  dischargedStamp    Boolean   @default(false)

  /// Person in charge of the courrier ("Affectations"): set at creation or
  /// later by the creator, the owning site's responsible, or a platform
  /// admin. Also gets access to its documents.
  ownerId String?

  /// "Répond à": the courrier this one was written in response to, in
  /// either direction (typically a sortant answering an entrant). Cleared,
  /// not cascaded, if that courrier is deleted.
  respondsToId String?

  proposedProjectId  String?
  proposedContractId String?
  proposedDossierId  String?
  proposedById       String?
  proposedAt         DateTime?

  dispatchValidatedById String?
  dispatchValidatedAt   DateTime?
  supervisorDueDate     DateTime?
  supervisorNote        String?

  /// Last submission for validation.
  submittedAt        DateTime?
  /// The validator's approval (VALIDE): when, and by whom.
  approvedAt         DateTime?
  approvedById       String?
  cancelledAt        DateTime?
  cancellationReason String?
  archivedAt         DateTime?
  archiveReason      String?
  /// The status it was archived from, given back by unarchive.
  archivedFromStatus CourrierStatus?

  /// An entrant handed to its responsible, a sortant sent: when, by whom.
  transmittedAt   DateTime?
  transmittedById String?
  /// An entrant's closure (CLOTURE) and its note.
  closedAt        DateTime?
  closingNote     String?

  // A sortant's signature (SIGNE): the signatory, the date, the signed scan.
  signedAt              DateTime?
  signedById            String?
  signedDocumentId      String?   @unique
  // Its sending (ENVOYE): how, to whom, under which bordereau BT-AAAA-NNNNNN.
  transmissionMode      String?   @db.VarChar(100)
  transmissionRecipient String?   @db.VarChar(255)
  bordereauNumber       String?   @unique @db.VarChar(30)
  // Its discharge (DECHARGE): who received it, and the discharged bordereau
  // (dischargedAt above).
  dischargeReceivedBy   String?   @db.VarChar(255)
  dischargeDocumentId   String?   @unique

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  respondsTo          Courrier?       @relation("CourrierResponses", fields: [respondsToId], references: [id], onDelete: SetNull)
  responses           Courrier[]      @relation("CourrierResponses")
  type                EffetType?      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  // SetNull: deleting a bordereau leaves the effets it listed in place.
  parent              Courrier?       @relation("BordereauEffets", fields: [parentId], references: [id], onDelete: SetNull)
  children            Courrier[]      @relation("BordereauEffets")
  dossier             Dossier?        @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract            Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  supervisor          User?           @relation("CourrierSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  proposedBy          User?           @relation("CourrierProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  dispatchValidatedBy User?           @relation("CourrierDispatchValidatedBy", fields: [dispatchValidatedById], references: [id], onDelete: SetNull)
  approvedBy          User?           @relation("CourrierApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  transmittedBy       User?           @relation("CourrierTransmittedBy", fields: [transmittedById], references: [id], onDelete: SetNull)
  signedBy            User?           @relation("CourrierSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  signedDocument      Document?       @relation("CourrierSignedDocument", fields: [signedDocumentId], references: [id], onDelete: SetNull)
  dischargeDocument   Document?       @relation("CourrierDischargeDocument", fields: [dischargeDocumentId], references: [id], onDelete: SetNull)
  correspondent       Correspondent?  @relation(fields: [correspondentId], references: [id])
  nature              CourrierNature? @relation(fields: [natureId], references: [id])
  canal               Canal?          @relation(fields: [canalId], references: [id])
  createdBy           User?           @relation("CourrierCreatedBy", fields: [createdById], references: [id])
  dischargedBy        User?           @relation("CourrierDischargedBy", fields: [dischargedById], references: [id])
  owner               User?           @relation("CourrierOwner", fields: [ownerId], references: [id])

  documents      Document[]
  instructions   Instruction[]
  notifications  Notification[]
  /// Decisions on its validation (MailService.validate/requestCorrections).
  validations    Validation[]
  /// Independent from the dossier's own access list — a user with access to
  /// the dossier is not automatically granted access to every courrier
  /// inside it, and vice versa.
  accesses       CourrierAccess[]
  /// Every analysis of this delivery: the live one plus the rejected
  /// versions it superseded.
  analysisSheets AnalysisSheet[]

  @@index([typeId])
  @@index([parentId])
  @@index([projectId])
  @@index([contractId])
  @@map("courrier")
}

/// Last number given per year to an approved sortant's reference
/// (SOR-AAAA-NNNNNN).
model CourrierSequence {
  year Int @id
  last Int @default(0)

  @@map("courrier_sequence")
}

/// Last bordereau de transmission number (BT-AAAA-NNNNNN) given each year.
model BordereauSequence {
  year Int @id
  last Int @default(0)

  @@map("bordereau_sequence")
}

/// Explicit per-user grant on a courrier — mirrors DossierAccess, but is a
/// wholly separate list: courrier access does not inherit from, or feed
/// into, its parent dossier's.
model CourrierAccess {
  id         String   @id @default(uuid())
  courrierId String
  userId     String
  canView    Boolean  @default(true)
  canEdit    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courrier Courrier @relation(fields: [courrierId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courrierId, userId])
  @@map("courrier_access")
}

// ---------------------------------------------------------------------------
// Traitement domain — Instruction / Livrable / Validation (BAD 6.3.2-3 / 7.3-4)
// ---------------------------------------------------------------------------

enum InstructionPriority {
  URGENT
  NORMAL
  MEDIUM
  LOW
}

enum InstructionStatus {
  A_AFFECTER
  /// Assigned, waiting for its executants to subscribe to it.
  AFFECTEE
  ACCEPTEE
  /// Every executant declined: back to its creator, who reassigns or
  /// adjusts it.
  NON_SOUSCRITE
  EN_COURS
  EN_ATTENTE_VALIDATION
  A_CORRIGER
  TERMINEE
  ANNULEE
}

enum UserInstructionRole {
  EXECUTANT
  SUPERVISEUR
  /// Optional: gives their opinion (AVIS) on each submitted livrable
  /// before the superviseur decides. Never decides. One per task at most.
  VALIDATEUR
}

/// Action (or set of actions) confided to collaborators as part of treating a
/// dossier (7.3). Always attached to a dossier; may additionally reference
/// the courrier that triggered it.
model Instruction {
  id                     String              @id @default(uuid())
  /// System-generated, human-readable reference (matches Dossier/Courrier).
  number                 String              @unique @db.VarChar(30)
  /// Exactly one of dossierId / contractId must be set (enforced in service).
  dossierId              String?
  contractId             String?
  courrierId             String?
  title                  String              @db.VarChar(200)
  description            String?
  priority               InstructionPriority @default(NORMAL)
  /// The task's deadline: validated by then. Set by its creator (from the
  /// dossier's responsible to the superviseur).
  dueDate                DateTime?
  /// The executants' deadline: livrables submitted by then. Set by the
  /// superviseur, or the creator when there is none; never after dueDate.
  agentDueDate           DateTime?
  /// 1, then +1 each time the creator changes what is asked once work has
  /// started. Corrections within the request keep the cycle and the
  /// deadlines.
  cycle                  Int                 @default(1)
  /// Overdue alerts already sent, so each is sent once; cleared when the
  /// deadline moves.
  agentOverdueNotifiedAt DateTime?
  /// Last reminder sent to its executants (POST /instructions/:id/remind).
  lastRemindedAt         DateTime?
  overdueNotifiedAt      DateTime?
  status                 InstructionStatus   @default(A_AFFECTER)
  /// Summary of the corrections last requested on its livrables. The
  /// motifs of non-subscriptions live in InstructionSubscription.
  refusalReason          String?
  /// Free-text note recorded when the task is (re)assigned.
  assignNote             String?
  /// Reason provided when the task is cancelled.
  cancellationReason     String?
  /// Comment recorded when the task is closed (TERMINEE).
  closingComment         String?
  createdById            String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  closedAt               DateTime?

  dossier   Dossier?  @relation(fields: [dossierId], references: [id])
  contract  Contract? @relation("InstructionContract", fields: [contractId], references: [id])
  courrier  Courrier? @relation(fields: [courrierId], references: [id])
  createdBy User?     @relation("InstructionCreatedBy", fields: [createdById], references: [id])

  assignees     UserInstructions[]
  livrables     Livrable[]
  validations   Validation[]
  /// Every executant's decision to subscribe or not, with its motif.
  subscriptions InstructionSubscription[]

  // RG-LIV-006: an instruction may depend on several others, and several
  // others may depend on it — modeled as a self many-to-many.
  dependsOn  InstructionDependency[] @relation("Dependent")
  dependents InstructionDependency[] @relation("Dependency")

  @@index([contractId])
  @@map("instruction")
}

model InstructionDependency {
  instructionId String
  dependsOnId   String

  instruction Instruction @relation("Dependent", fields: [instructionId], references: [id])
  dependsOn   Instruction @relation("Dependency", fields: [dependsOnId], references: [id])

  @@id([instructionId, dependsOnId])
  @@map("instruction_dependency")
}

/// Who is assigned to an instruction, and in what capacity (7.3.6 /
/// RG-INS-002): directly to an executant, or to a superviseur who then
/// assigns/reassigns executants.
enum SubscriptionDecision {
  SOUSCRITE
  NON_SOUSCRITE
}

/// An executant's decision on a task assigned to them: they subscribe to it
/// (and start working), or they don't, with a motif — then they leave the
/// task. Kept as history: a task can be declined several times.
model InstructionSubscription {
  id            String               @id @default(uuid())
  instructionId String
  userId        String
  decision      SubscriptionDecision
  motif         String?
  decidedAt     DateTime             @default(now())

  instruction Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([instructionId])
  @@map("instruction_subscription")
}

model UserInstructions {
  userId        String
  instructionId String
  role          UserInstructionRole

  user        User        @relation(fields: [userId], references: [id])
  instruction Instruction @relation(fields: [instructionId], references: [id])

  @@id([userId, instructionId, role])
  @@map("user_instructions")
}

enum LivrableStatus {
  EN_PREPARATION
  DEPOSE
  SOUMIS
  EN_VALIDATION
  REJETE
  VALIDE
  ARCHIVE
}

/// The expected result of an instruction (7.4). Versioned: an edit after
/// deposit creates a new version rather than mutating history (RG-LIV-007).
model Livrable {
  id              String         @id @default(uuid())
  instructionId   String
  title           String         @db.VarChar(200)
  description     String?
  status          LivrableStatus @default(EN_PREPARATION)
  /// Its rank among the task's livrables, in the order they were entered
  /// (0, 1, 2...; added later: after the others). Kept by its new versions.
  position        Int            @default(0)
  /// While SOUMIS: 0 = awaits the validateur's opinion (AVIS), 1 = awaits
  /// the superviseur's decision. A task without a validateur: its
  /// superviseur decides from 0. Back to 0 at each submission.
  validationStep  Int            @default(0)
  version         Int            @default(1)
  /// False once a newer version replaces this one. History is linear:
  /// only the latest version, once REJETE, can get a new version.
  isLatest        Boolean        @default(true)
  parentVersionId String?
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Optional comment from the agent when depositing the livrable.
  agentComment    String?

  instruction   Instruction @relation(fields: [instructionId], references: [id])
  parentVersion Livrable?   @relation("LivrableVersions", fields: [parentVersionId], references: [id])
  versions      Livrable[]  @relation("LivrableVersions")
  createdBy     User?       @relation("LivrableCreatedBy", fields: [createdById], references: [id])

  documents     Document[]
  /// Supervisor decisions on this version, with their motifs (10.4.4.6).
  validations   Validation[]
  /// The structured analysis this livrable carries, when it is a
  /// "fiche d'analyse" rather than a plain file deliverable.
  analysisSheet AnalysisSheet?

  @@map("livrable")
}

enum ValidationDecision {
  VALIDE
  REJETE
  CORRECTIONS_DEMANDEES
  /// The validateur's opinion on a livrable (its `comment`): no decision —
  /// the superviseur decides after it.
  AVIS
}

/// A validation decision (10.6). Applies to an instruction (and, through it,
/// its livrables — RG-LIV-005: validation is pronounced on the instruction as
/// a whole), to a courrier submitted for validation, or to an analysis sheet.
model Validation {
  id              String             @id @default(uuid())
  instructionId   String?
  /// Decision on one livrable of the instruction (approved, or rejected
  /// with its own motif) — one row per livrable and per decision.
  livrableId      String?
  courrierId      String?
  analysisSheetId String?
  validatorId     String
  decision        ValidationDecision
  /// The task's cycle the decision was made in (Instruction.cycle).
  cycle           Int?
  motif           String?
  /// The validateur's opinion, with an AVIS.
  comment         String?
  decidedAt       DateTime           @default(now())

  instruction   Instruction?   @relation(fields: [instructionId], references: [id])
  livrable      Livrable?      @relation(fields: [livrableId], references: [id], onDelete: Cascade)
  courrier      Courrier?      @relation(fields: [courrierId], references: [id], onDelete: Cascade)
  analysisSheet AnalysisSheet? @relation(fields: [analysisSheetId], references: [id])
  validator     User           @relation(fields: [validatorId], references: [id])

  @@index([livrableId])
  @@index([courrierId])
  @@map("validation")
}

// ---------------------------------------------------------------------------
// Documents (generic attachments — BAD "Pièces jointes" / "Documents associés")
// ---------------------------------------------------------------------------

/// A stored file, attached to exactly one of Dossier / Courrier / Livrable.
/// The `storageKey` is the object key in the S3-compatible bucket (see
/// StorageService); this table is the metadata/ownership index over it.
model Document {
  id           String  @id @default(uuid())
  /// Original filename as sent by the client.
  originalName String
  /// Optional human-readable display name (defaults to originalName if not set at upload).
  name         String?
  storageKey   String  @unique
  mimeType     String?
  sizeBytes    Int?

  dossierId  String?
  courrierId String?
  livrableId String?
  contractId String?

  uploadedById String?
  createdAt    DateTime @default(now())

  /// Person in charge of the document — same semantics as Courrier.ownerId.
  ownerId String?

  dossier    Dossier?  @relation(fields: [dossierId], references: [id])
  courrier   Courrier? @relation(fields: [courrierId], references: [id])
  livrable   Livrable? @relation(fields: [livrableId], references: [id])
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  uploadedBy User?     @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  owner      User?     @relation("DocumentOwner", fields: [ownerId], references: [id])

  /// Independent from its dossier's/courrier's own access list, same
  /// reasoning as CourrierAccess.
  accesses            DocumentAccess[]
  analysisItems       AnalysisItem[]
  /// The sortant it is the signed scan / the discharged bordereau of.
  signedCourrier      Courrier?        @relation("CourrierSignedDocument")
  signedAnalysisSheet AnalysisSheet?   @relation("AnalysisSheetSignedDocument")
  dischargedCourrier  Courrier?        @relation("CourrierDischargeDocument")

  @@map("document")
}

/// Explicit per-user grant on a single document — mirrors DossierAccess and
/// CourrierAccess, each level's list independent of the others.
model DocumentAccess {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  canView    Boolean  @default(true)
  canEdit    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@map("document_access")
}

// ---------------------------------------------------------------------------
// Collaboration domain — Notifications (BAD RG-NOT-*)
// ---------------------------------------------------------------------------

enum NotificationCanal {
  IN_APP
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  NOT_READ
  READ
  ARCHIVED
}

/// A notifiable event (RG-NOT-*). Deliberately has no direct `userId`: it
/// may be fanned out to several recipients at once (e.g. RG-NOT-003 — a
/// missed deadline notifies "l'ensemble des acteurs concernés"), each
/// tracked individually through UserNotification.
model Notification {
  id         String            @id @default(uuid())
  dossierId  String?
  courrierId String?
  type       String            @db.VarChar(50)
  message    String?
  canal      NotificationCanal
  createdAt  DateTime          @default(now())

  dossier  Dossier?  @relation(fields: [dossierId], references: [id])
  courrier Courrier? @relation(fields: [courrierId], references: [id])

  recipients UserNotification[]

  @@map("notification")
}

model UserNotification {
  userId         String
  notificationId String
  status         NotificationStatus @default(NOT_READ)

  user         User         @relation(fields: [userId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id])

  @@id([userId, notificationId])
  @@map("user_notification")
}

/// A notification type a user chose not to receive (opt-out: no row means
/// they get it). See NOTIFICATION_TYPES for the types one can turn off.
model NotificationPreference {
  userId    String
  type      String   @db.VarChar(50)
  enabled   Boolean
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preference")
}

// ---------------------------------------------------------------------------
// Administration domain — Activity log (BAD RG-AUD-*)
// ---------------------------------------------------------------------------

enum ActivitySource {
  USER
  SYSTEM
}

enum ActivityLevel {
  info
  warn
  error
}

/// Every action taken on the platform (RG-AUD-001/002 + free-form system
/// events — supersedes the earlier separate AuditLog/SystemLog models):
/// who (or what system process), when, what, on which object. `userId` is
/// deliberately a loose reference (no FK) so logging never fails or blocks
/// on a broken relation, and so SYSTEM-sourced entries (no user) fit the
/// same table. `parentLogId` correlates a chain of related events (e.g. one
/// request producing several entity-level entries).
model ActivityLog {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now())
  parentLogId String?
  userId      String?
  actorLabel  String?        @db.VarChar(100)
  source      ActivitySource
  level       ActivityLevel
  action      String         @db.VarChar(255)
  entityType  String?        @db.VarChar(50)
  entityId    String?
  message     String?        @db.Text
  stack       String?        @db.Text
  metadata    Json?
  /// The site the entry belongs to: its object's site (an effet's, a
  /// dossier's, a project's...), else its author's. Null: a platform-wide
  /// object (a global role, a common referential) — platform audit only.
  siteId      String?
  /// The author's IP address.
  ip          String?        @db.VarChar(64)

  parent   ActivityLog?  @relation("ActivityLogTree", fields: [parentLogId], references: [id])
  children ActivityLog[] @relation("ActivityLogTree")

  @@index([parentLogId])
  @@index([siteId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([source, createdAt])
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Analysis sheets — "Fiches d'analyse / Avis" (module spec 10/09/2026)
// ---------------------------------------------------------------------------

/// The 5-value scale every criterion, element and delivery is judged on.
enum AnalysisOpinion {
  /// Avis favorable — tout est bon.
  AF
  /// Avis favorable sous réserve — bon, avec des ajustements à faire.
  AFR
  /// Avis suspendu — des corrections sont nécessaires pour avancer.
  AS
  /// Avis défavorable — à revoir entièrement.
  AD
  /// Non applicable.
  NA
}

/// A fiche d'analyse's own lifecycle: BROUILLON (being filled) ->
/// ENREGISTREE (complete, ready to sign) -> SIGNEE (signed scan recorded,
/// locked) -> ARCHIVEE. Changes after signature go into a new version.
enum AnalysisSheetStatus {
  BROUILLON
  ENREGISTREE
  SIGNEE
  ARCHIVEE
}

/// The structured evaluation of one delivery (a courrier entrant carrying a
/// bordereau and its documents). Content only: the lifecycle, the versioning
/// and the validation live on the owning Livrable, so an analysis behaves
/// like any other deliverable of its instruction.
model AnalysisSheet {
  id            String              @id @default(uuid())
  /// System-generated, human-readable reference (FA-xxxxxx).
  reference     String              @unique @db.VarChar(30)
  /// The deliverable carrying this analysis, when it answers an instruction
  /// — one sheet per livrable version. Null for a fiche opened from the
  /// effet alone.
  livrableId    String?             @unique
  /// The delivery being analysed. Not unique: a rejected fiche is kept and
  /// superseded by a new version, so several sheets can share one courrier —
  /// only one of them is ever live (see assertNoLiveSheet).
  courrierId    String
  /// Denormalised from the courrier, for listing and site scoping: its
  /// dossier, or its contract when it has none — at least one of the two.
  /// Without a dossier, the fiche belongs to the site of whoever registered
  /// the courrier.
  dossierId     String?
  contractId    String?
  projectId     String?
  /// The version this one replaces (null on a first analysis).
  parentSheetId String?             @unique
  /// "1.0", then "1.1", "1.2"... along parentSheetId.
  version       String              @default("1.0") @db.VarChar(10)
  /// Why this version was opened.
  versionMotif  String?
  status        AnalysisSheetStatus @default(BROUILLON)
  /// The expert who produced it (one author per sheet).
  authorId      String

  /// Identification block of the paper form.
  refBL          String?   @db.VarChar(50)
  lieuUsage      String?   @db.VarChar(150)
  remise         DateTime?
  norme          String?   @db.VarChar(150)
  /// "Docs références" — ex. Dossier d'exécution, Plans d'exécution...
  docsReferences String[]  @default([])

  /// "Objet de la remise", and the rest of the paper form's header.
  title             String? @db.VarChar(255)
  mode              String? @db.VarChar(100)
  projectReference  String? @db.VarChar(100)
  /// Maître d'ouvrage, as written on the fiche.
  owner             String? @db.VarChar(255)
  allotment         String? @db.VarChar(255)
  authorFunction    String? @db.VarChar(150)
  /// Who validates the fiche, as named on it.
  validatorId       String?
  validatorFunction String? @db.VarChar(150)
  comments          String?

  // Signature (SIGNEE): the signed scan, its signatory, its date.
  signedAt           DateTime?
  signatoryName      String?              @db.VarChar(255)
  signedDocumentId   String?              @unique
  archivedAt         DateTime?
  archiveReason      String?
  /// The status it was archived from, given back by unarchive.
  archivedFromStatus AnalysisSheetStatus?

  /// Derived from the elements (AD if any element is AD, else AS if any is
  /// AS, else AF — AFR counts as favourable). A proposal only.
  suggestedOpinion AnalysisOpinion?
  /// The avis that stands: set by the person in charge, who may depart from
  /// the suggestion. Null until they pronounce.
  overallOpinion   AnalysisOpinion?
  /// Why the final avis differs from the suggestion, when it does.
  opinionMotif     String?
  decidedById      String?
  decidedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  livrable       Livrable? @relation(fields: [livrableId], references: [id], onDelete: Cascade)
  courrier       Courrier  @relation(fields: [courrierId], references: [id])
  dossier        Dossier?  @relation(fields: [dossierId], references: [id], onDelete: Restrict)
  contract       Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  project        Project?  @relation(fields: [projectId], references: [id])
  author         User      @relation("AnalysisSheetAuthor", fields: [authorId], references: [id])
  decidedBy      User?     @relation("AnalysisSheetDecidedBy", fields: [decidedById], references: [id])
  validator      User?     @relation("AnalysisSheetValidator", fields: [validatorId], references: [id], onDelete: SetNull)
  signedDocument Document? @relation("AnalysisSheetSignedDocument", fields: [signedDocumentId], references: [id], onDelete: SetNull)

  parentSheet AnalysisSheet? @relation("AnalysisSheetVersions", fields: [parentSheetId], references: [id])
  nextVersion AnalysisSheet? @relation("AnalysisSheetVersions")

  items       AnalysisItem[]
  validations Validation[]

  @@index([dossierId])
  @@index([contractId])
  @@index([courrierId])
  @@map("analysis_sheet")
}

/// One "élément à analyser": a single received document, judged on its own
/// grid of criteria. Criteria of different elements are unrelated (spec §4).
model AnalysisItem {
  id               String           @id @default(uuid())
  sheetId          String
  /// The received document this element evaluates, if any.
  documentId       String?
  label            String           @db.VarChar(200)
  /// Norms / references this element is checked against.
  norms            String?
  description      String?
  observation      String?
  /// Proposed by the system from the criteria (worst one wins).
  suggestedOpinion AnalysisOpinion?
  /// What the expert actually pronounces — the decision is always theirs.
  opinion          AnalysisOpinion?
  order            Int

  sheet    AnalysisSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  document Document?     @relation(fields: [documentId], references: [id])

  criteria AnalysisItemCriterion[]

  @@unique([sheetId, documentId])
  @@unique([sheetId, order])
  @@map("analysis_item")
}

/// A criterion line under one element. Copied from the template catalogue at
/// creation (label included) so later edits to the catalogue never rewrite a
/// sheet that has already been filled.
model AnalysisItemCriterion {
  id          String          @id @default(uuid())
  itemId      String
  templateId  String?
  label       String          @db.VarChar(150)
  opinion     AnalysisOpinion @default(NA)
  observation String?
  order       Int

  item     AnalysisItem               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  template AnalysisCriterionTemplate? @relation(fields: [templateId], references: [id])

  @@unique([itemId, label])
  @@map("analysis_item_criterion")
}

/// Admin-managed default grid ("document de critères d'analyse"): Forme,
/// Fonctionnalité, Constitution, Conformité aux cahiers des charges,
/// Exploitabilité, Autres conformités.
/// A criterion of the catalogue: common to every site (no site, managed by
/// a platform administrator), or of one site (managed by whoever holds
/// ADMIN_MANAGE_ANALYSIS_CRITERIA there). A fiche offers the common ones plus
/// its site's.
model AnalysisCriterionTemplate {
  id               String  @id @default(uuid())
  label            String  @db.VarChar(150)
  siteId           String?
  description      String?
  order            Int     @default(0)
  isActive         Boolean @default(true)
  /// Put on every new element; otherwise offered, to be added by hand.
  appliedByDefault Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     Site?                   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  criteria AnalysisItemCriterion[]

  /// A label is unique among the common criteria and within each site (NULLS
  /// NOT DISTINCT, see the migration).
  @@unique([siteId, label])
  @@map("analysis_criterion_template")
}

/// The platform's settings: a single row (id 1).
model AppSettings {
  id                            Int      @id @default(1)
  /// Most instructions in progress an agent should carry at once (null: no
  /// limit). An indicator for whoever assigns tasks.
  maxActiveInstructionsPerAgent Int?
  updatedAt                     DateTime @updatedAt

  @@map("app_settings")
}

/// Settings of the fiches d'analyse: a single row (id 1).
model AnalysisSettings {
  id                  Int      @id @default(1)
  /// Whether an element may carry criteria outside the catalogue.
  allowCustomCriteria Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  @@map("analysis_settings")
}

/// A site's own settings for its fiches, over the common ones
/// (AnalysisSettings) — absent: the common ones apply.
model AnalysisSiteSettings {
  siteId              String   @id
  allowCustomCriteria Boolean
  updatedAt           DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("analysis_site_settings")
}

/// An invitation to join (A·12): the account is created when the invitee
/// accepts it with their password (POST /auth/invitations/accept). Pending:
/// neither accepted nor revoked, and not expired.
model Invitation {
  id          String    @id @default(uuid())
  email       String    @db.VarChar(150)
  name        String
  siteId      String?
  /// The role it will hold, at its site (or globally without a site).
  roleId      String?
  invitedById String?
  tokenHash   String    @unique
  sentAt      DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  /// The account created on acceptance.
  userId      String?   @unique

  site      Site? @relation(fields: [siteId], references: [id], onDelete: Restrict)
  role      Role? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy User? @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  user      User? @relation("InvitationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([email])
  @@map("invitation")
}
